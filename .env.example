# ─── Ma'lumotlar bazasi ───────────────────────────────
# SQLite (default). PostgreSQL uchun: postgresql+asyncpg://user:pass@localhost/dbname
DATABASE_URL=sqlite+aiosqlite:///app.db

# ─── Web server ───────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── Telegram WebApp ──────────────────────────────────
# Web-kabinet Telegram'ning O'Z menyu tugmasi orqali ochiladi (xabar maydoni
# yonidagi tugma). Telegram Mini App faqat HTTPS manzilni qabul qiladi:
#   WEBAPP_URL=https://<domen>          ← productionda shunday bo'lsin
# Lokal sinov uchun tunnel: cloudflared tunnel --url http://localhost:8000
# HTTPS bo'lmasa menyu tugmasi o'rnatilmaydi; brauzer havolasini /getsession beradi.
# Bo'sh qoldirilsa WebApp umuman o'chiriladi.
WEBAPP_URL=https://your-domain.example

# ─── Admin auth API ───────────────────────────────────
# Admin panel login/profil uchun tashqi API bazaviy manzili.
AUTH_API_BASE=https://tashqisavdo-tashqi-savda-backend-dykybk-722d50-85-17-200-46.sslip.io/api/v1
# Muqobil: https://distr.mxsoft.uz/api/v1

# ─── Sessiya ──────────────────────────────────────────
# Cookie sessiyalarini imzolash uchun maxfiy kalit. Productionda o'zgartiring!
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# ─── Performance ──────────────────────────────────────
# 1C katalog keshi (soniya). 0 = o'chirilgan.
PRODUCTS_CACHE_TTL=30

# ─── PDF (акт сверка) ─────────────────────────────────
# Кирилл матн учун Unicode TTF шрифт. Одатда автоматик топилади
# (macOS: Arial, Linux: DejaVu/Liberation/Noto). Топилмаса матн лотинга
# ўгирилади — серверда шрифт ўрнатинг: apt install fonts-dejavu-core
# ёки бу ерда аниқ йўлни кўрсатинг:
# PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
